{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/company/dashboard",
      "dest": "public/admin.html"
    },
    {
      "src": "/company/(.*)",
      "dest": "public/admin.html"
    },
    {
      "src": "/employee/dashboard",
      "dest": "public/index.html"
    },
    {
      "src": "/employee/(.*)",
      "dest": "public/index.html"
    },
    {
      "src": "/admin",
      "dest": "public/admin.html"
    },
    {
      "src": "/login",
      "dest": "public/login.html"
    },
    {
      "src": "/login.html",
      "dest": "public/login.html"
    },
    {
      "src": "/",
      "dest": "public/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}